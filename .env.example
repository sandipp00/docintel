# Copy to .env and fill in. Never commit .env.

# LLM provider: groq | gemini | none  (none = baseline extraction + extractive fallbacks only)
LLM_PROVIDER=groq

# Free keys: https://console.groq.com/keys  |  https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-flash-lite-latest
LLM_TIMEOUT_SECONDS=30
LLM_RPM=14

# Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# Limits & retention
MAX_UPLOAD_MB=10
RETENTION_MINUTES=60
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_ASK=20/minute

# Server
CORS_ORIGINS=*
LOG_LEVEL=INFO
# Windows only, if tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
